// * HK - Git Hook Configuration
// This file ensures you are committing properly linted and formatted files which will pass ci
amends "package://github.com/jdx/hk/releases/download/v2.3.1/hk@2.3.1#/Config.pkl"

import "generated/generated.pkl"

steps = generated.addSteps(generated.steps)

exclude = List("fonts/*")

skip_steps =
  List(
    "[fix] markdown license" // License text modified to include font licensing
  )
